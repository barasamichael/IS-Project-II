# Required: OpenAI API key for LLM calls and embedding generation.
OPENAI_API_KEY=

# Optional: Tavily API key for web search. System operates without it.
TAVILY_API_KEY=

# Required: API key for authenticating requests to the SettleBot RAG API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must not be set to "your_secure_random_key_here".
SETTLEBOT_API_KEY=

# Required: Locale name. Maps to config/locale/{SETTLEBOT_LOCALE}.json
# Example value: nairobi
SETTLEBOT_LOCALE=
