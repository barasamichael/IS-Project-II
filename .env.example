# =============================================================================
# SettleBot RAG API — environment variables
# Copy this file to .env and fill in all Required entries before running.
# =============================================================================

# -----------------------------------------------------------------------------
# External API keys
# -----------------------------------------------------------------------------

# Required: OpenAI API key for LLM calls and embedding generation.
OPENAI_API_KEY=

# Optional: Tavily API key for web search. System operates in local-only mode
# without it.
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------

# Required: Shared secret used to authenticate requests to the RAG API.
# Must match SETTLEBOT_API_KEY in the frontend .env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must not be left as "your_secure_random_key_here".
SETTLEBOT_API_KEY=

# -----------------------------------------------------------------------------
# Locale
# -----------------------------------------------------------------------------

# Required: Locale identifier. Resolves to config/locale/{SETTLEBOT_LOCALE}.json
# Example: nairobi
SETTLEBOT_LOCALE=

# -----------------------------------------------------------------------------
# Server binding (optional overrides — defaults: 0.0.0.0 / 8000)
# -----------------------------------------------------------------------------

HOST=
PORT=

# -----------------------------------------------------------------------------
# Chunking and deduplication (optional overrides)
# -----------------------------------------------------------------------------

# Override the chunking strategy defined in config/settings.json.
# Example values: semantic, fixed, sentence
CHUNKING_STRATEGY=

# Set to "true" to enable near-duplicate chunk removal at index time.
DEDUPLICATION_ENABLED=
