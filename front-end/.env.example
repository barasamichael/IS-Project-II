# =============================================================================
# SettleBot Flask frontend — environment variables
# Copy this file to front-end/.env and fill in all Required entries.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask security
# -----------------------------------------------------------------------------

# Required in production: random secret key used to sign sessions and cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never use the fallback hardcoded value in production.
SECRET_KEY=

# -----------------------------------------------------------------------------
# RAG API connection
# -----------------------------------------------------------------------------

# Required when the frontend is not co-hosted with the RAG API.
# Default (development): http://127.0.0.1:8000/
SETTLEBOT_API_URL=

# Required: Must match SETTLEBOT_API_KEY in the RAG API .env.
SETTLEBOT_API_KEY=

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------

# Optional: Display name used in email subjects and page titles.
# Default: SettleBot
ORGANIZATION_NAME=

# -----------------------------------------------------------------------------
# Mail (Zoho Mail API — OAuth)
# Obtain these from the Zoho API Console: https://api-console.zoho.com/
# -----------------------------------------------------------------------------

# Required: OAuth client ID from the Zoho API console.
ZOHO_CLIENT_ID=

# Required: OAuth client secret from the Zoho API console.
ZOHO_CLIENT_SECRET=

# Required: Long-lived refresh token generated during OAuth authorisation.
ZOHO_REFRESH_TOKEN=

# Required: Zoho account ID (numeric). Find it at:
#   GET https://mail.zoho.com/api/accounts
ZOHO_ACCOUNT_ID=

# Required: The From address used for all outgoing mail.
# Example: SettleBot <info@example.com>
ZOHO_FROM_ADDRESS=

# Optional: Override for non-EU data-centre accounts.
# Default: https://accounts.zoho.com  (use https://accounts.zoho.eu for EU)
ZOHO_ACCOUNTS_BASE=

# Optional: Override for non-EU data-centre accounts.
# Default: https://mail.zoho.com  (use https://mail.zoho.eu for EU)
ZOHO_MAIL_BASE=

# Optional: HTTP request timeout in seconds. Default: 20
ZOHO_HTTP_TIMEOUT=

# Optional: Address that receives administrator notifications.
# Default: mkuu@jisortublow.co.ke
ADMINISTRATOR_MAIL=

# -----------------------------------------------------------------------------
# Database — development
# -----------------------------------------------------------------------------

# Optional: Full SQLAlchemy URL for the development database.
# Default: sqlite:///<basedir>/development.db
DEVELOPMENT_DATABASE_URL=

# -----------------------------------------------------------------------------
# Database — production
# -----------------------------------------------------------------------------

# Option A: Provide the full connection URL directly.
PRODUCTION_DATABASE_URL=

# Option B: Provide individual components (used only when PRODUCTION_DATABASE_URL
# is not set). All four must be set together.
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
